{
    "name": "albertoarena/phplives.dev",
    "description": "A running showcase of what people are shipping in PHP right now.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "chillerlan/php-qrcode": "^6.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "PhpLives\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
