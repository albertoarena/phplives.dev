#!/usr/bin/env php
<?php

/**
 * Checks that every link in some entry files still works.
 *
 *   bin/check-links [--entries=entries] [--today=YYYY-MM-DD] [--wait=5]
 *                   [--state=warnings.json] [--annotate] [entries/file.php ...]
 *
 * With no files, it checks every entry. It fails when a link is broken: a
 * missing page, a domain that is gone, a bad certificate. A server error, a rate
 * limit, a 403 or no answer only gives a warning, because it is usually the
 * other site's problem for a while, or a block on scripts. Such a link gets one more try after --wait seconds.
 *
 * With --state, it keeps the links that warned in a JSON file, and a link that
 * warns on LinkWarnings::RUNS_TO_FAIL runs in a row counts as broken. With
 * --annotate, it marks each warning for the GitHub Actions run page.
 */

declare(strict_types=1);

use PhpLives\Entries;
use PhpLives\InvalidEntries;
use PhpLives\LinkCheck;
use PhpLives\LinkWarnings;

require __DIR__.'/../vendor/autoload.php';

$root = dirname(__DIR__);
$options = getopt('', ['entries:', 'today:', 'wait:', 'state:', 'annotate'], $rest) + [
    'entries' => "{$root}/entries",
    'today' => 'today',
    'wait' => LinkCheck::RETRY_SECONDS,
];
$files = array_map(basename(...), array_slice($argv, $rest));

$today = new DateTimeImmutable($options['today'], new DateTimeZone('UTC'));

try {
    $entries = Entries::load($options['entries'], $today);
} catch (InvalidEntries $e) {
    fwrite(STDERR, $e->getMessage()."\n");
    exit(1);
}

$byFile = [];

foreach ($entries->all() as $entry) {
    $byFile[$entry->shipped->format('Y-m-d')."-{$entry->slug}.php"] = $entry;
}

if ($missing = array_diff($files, array_keys($byFile))) {
    foreach ($missing as $file) {
        fwrite(STDERR, "Not an entry file: {$file}\n");
    }

    exit(1);
}

$wait = (int) $options['wait'];
$check = new LinkCheck(wait: static function () use ($wait): void {
    sleep($wait);
});
$state = $options['state'] ?? null;
$warnings = $state === null ? null : LinkWarnings::load($state);
$annotate = isset($options['annotate']);
$checked = 0;
$broken = 0;
$warned = 0;

foreach ($files ? array_intersect_key($byFile, array_flip($files)) : $byFile as $file => $entry) {
    echo "{$file}\n";

    foreach (LinkCheck::links($entry) as $url) {
        $status = $check->status($url);
        $label = $status->label();
        $checked++;

        if ($status->ok()) {
            echo "  ok ({$label}) {$url}\n";
        } elseif ($status->fails()) {
            $broken++;
            echo "  broken ({$label}) {$url}\n";
        } elseif (($runs = $warnings?->warn($url) ?? 1) >= LinkWarnings::RUNS_TO_FAIL) {
            $broken++;
            echo "  broken ({$label}, {$runs} runs in a row) {$url}\n";
        } else {
            $warned++;
            echo "  warning ({$label}) {$url}\n";

            if ($annotate) {
                echo "::warning file=entries/{$file}::".ucfirst($status->code === 0 ? $label : "status {$label}")." from {$url}\n";
            }
        }
    }
}

$warnings?->save($state);

printf(
    "%d %s checked, %d broken, %d %s.\n",
    $checked,
    $checked === 1 ? 'link' : 'links',
    $broken,
    $warned,
    $warned === 1 ? 'warning' : 'warnings',
);

exit($broken > 0 ? 1 : 0);
